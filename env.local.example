# Optional .env for docker-compose (gitignored). Compose defaults to Apple Silicon (arm64).
#
# Intel / amd64 Linux — pick one:
#   BUILD_PLATFORM=linux/amd64
#   TARGETARCH=amd64
#
# Auto-detect this machine:
#   ./scripts/compose-platform.sh > .env
#
# Apple Silicon can omit .env and use compose defaults, or run the same script.
