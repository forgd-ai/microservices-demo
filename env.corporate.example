# Corporate network — use with: docker-compose --env-file env.corporate.example build
# Do NOT copy to .env unless you also set platform (see env.local.example / compose-platform.sh).
#
# Go module proxy (passed to Go services via compose build args):
GOPROXY=https://proxy.golang.org,direct
#
# HTTP/HTTPS proxy for Gradle, npm, pip, apk (not in Dockerfiles — set one of):
#   export HTTP_PROXY=http://proxy.company.com:8080
#   export HTTPS_PROXY=http://proxy.company.com:8080
#   export NO_PROXY=localhost,127.0.0.1
#   # and/or ~/.gradle/gradle.properties (Mark's systemProp.* settings)
#   # and/or Docker daemon proxies in ~/.docker/config.json
